# Jarvis — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ===== REQUIRED =====
OPENAI_API_KEY=sk-xxxx

# ===== OPTIONAL (defaults shown) =====
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765

# Model IDs (don't change unless OpenAI releases new versions)
MODEL_REASONING_DEFAULT=gpt-5.6-luna
MODEL_REASONING_COMPLEX=gpt-5.6-terra
MODEL_STT=gpt-live-transcribe
MODEL_TTS=tts-1
TTS_VOICE=onyx

# Rate limiting
DAILY_REQUEST_LIMIT=500

# Logging
LOG_LEVEL=INFO
